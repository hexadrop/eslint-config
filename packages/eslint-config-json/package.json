{
	"name": "@hexadrop/eslint-config-json",
	"version": "1.0.11",
	"description": "JSON slice of the hexadrop ESLint config: jsonc plugin, jsonc parser and canonical sort-keys for package.json and tsconfig.json.",
	"keywords": [
		"lint",
		"eslint",
		"eslint-config",
		"json",
		"jsonc"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hexadrop/eslint-config.git",
		"directory": "packages/eslint-config-json"
	},
	"homepage": "https://github.com/hexadrop/eslint-config",
	"bugs": {
		"url": "https://github.com/hexadrop/eslint-config/issues"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "bun run build:types && tsdown",
		"build:types": "bun run scripts/typegen.ts",
		"prepare": "bun run build:types",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"eslint": "^9.17.0 || ^10.0.0"
	},
	"dependencies": {
		"eslint-flat-config-utils": "3.2.0",
		"eslint-plugin-jsonc": "3.4.2",
		"jsonc-eslint-parser": "3.3.0"
	},
	"devDependencies": {
		"eslint-typegen": "2.3.1",
		"tsdown": "0.22.14"
	}
}
