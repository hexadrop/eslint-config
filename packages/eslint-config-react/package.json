{
	"name": "@hexadrop/eslint-config-react",
	"version": "1.0.11",
	"description": "React slice of the hexadrop ESLint config: eslint-plugin-react, react-hooks and react-refresh rules for jsx and tsx files.",
	"keywords": [
		"lint",
		"eslint",
		"eslint-config",
		"react"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hexadrop/eslint-config.git",
		"directory": "packages/eslint-config-react"
	},
	"homepage": "https://github.com/hexadrop/eslint-config",
	"bugs": {
		"url": "https://github.com/hexadrop/eslint-config/issues"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "bun run build:types && tsdown",
		"build:types": "bun run scripts/typegen.ts",
		"prepare": "bun run build:types",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"@hexadrop/eslint-config-typescript": "1.0.11",
		"eslint": "^9.17.0 || ^10.0.0"
	},
	"peerDependenciesMeta": {
		"@hexadrop/eslint-config-typescript": {
			"optional": true
		}
	},
	"dependencies": {
		"eslint-flat-config-utils": "3.2.0",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.5.5",
		"local-pkg": "1.2.1"
	},
	"devDependencies": {
		"eslint-typegen": "2.3.1",
		"tsdown": "0.22.14"
	}
}
