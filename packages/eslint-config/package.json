{
	"name": "@hexadrop/eslint-config",
	"version": "1.0.11",
	"description": "Opinionated linting configuration using best practices and providing consistency to your code.",
	"keywords": [
		"lint",
		"eslint",
		"eslint-config",
		"monorepo",
		"scalable",
		"scale",
		"typescript",
		"prettier"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hexadrop/eslint-config.git",
		"directory": "packages/eslint-config"
	},
	"homepage": "https://github.com/hexadrop/eslint-config",
	"bugs": {
		"url": "https://github.com/hexadrop/eslint-config/issues"
	},
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "bun run build:types && tsdown",
		"build:types": "bun run scripts/typegen.ts",
		"prepare": "bun run build:types",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"eslint": "^9.17.0 || ^10.0.0"
	},
	"dependencies": {
		"@hexadrop/eslint-config-json": "1.0.11",
		"@hexadrop/eslint-config-markdown": "1.0.11",
		"@hexadrop/eslint-config-react": "1.0.11",
		"@hexadrop/eslint-config-typescript": "1.0.11",
		"@stylistic/eslint-plugin": "5.10.0",
		"@typescript-eslint/eslint-plugin": "8.68.0",
		"@typescript-eslint/parser": "8.68.0",
		"astro-eslint-parser": "3.1.0",
		"eslint-config-flat-gitignore": "2.3.0",
		"eslint-flat-config-utils": "3.2.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-astro": "3.1.0",
		"eslint-plugin-format": "2.0.1",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-n": "18.3.0",
		"eslint-plugin-perfectionist": "5.10.1",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"eslint-plugin-unicorn": "73.0.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.11.0",
		"local-pkg": "1.2.1",
		"prettier": "3.9.6",
		"prettier-plugin-astro": "0.14.1",
		"tslib": "2.8.1"
	},
	"devDependencies": {
		"astro": "7.2.8",
		"eslint-typegen": "2.3.1",
		"react": "19.2.8",
		"tsdown": "0.22.14"
	}
}
