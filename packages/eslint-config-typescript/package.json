{
	"name": "@hexadrop/eslint-config-typescript",
	"version": "1.0.11",
	"description": "TypeScript slice of the hexadrop ESLint config: typescript-eslint plugin, parser, project-service wiring and type-aware rules.",
	"keywords": [
		"lint",
		"eslint",
		"eslint-config",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hexadrop/eslint-config.git",
		"directory": "packages/eslint-config-typescript"
	},
	"homepage": "https://github.com/hexadrop/eslint-config",
	"bugs": {
		"url": "https://github.com/hexadrop/eslint-config/issues"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "bun run build:types && tsdown",
		"build:types": "bun run scripts/typegen.ts",
		"prepare": "bun run build:types",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"eslint": "^9.17.0 || ^10.0.0"
	},
	"dependencies": {
		"@typescript-eslint/eslint-plugin": "8.68.0",
		"@typescript-eslint/parser": "8.68.0",
		"eslint-flat-config-utils": "3.2.0"
	},
	"devDependencies": {
		"tsdown": "0.22.14"
	}
}
