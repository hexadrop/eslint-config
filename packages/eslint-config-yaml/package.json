{
	"name": "@hexadrop/eslint-config-yaml",
	"version": "1.0.0",
	"description": "YAML slice of the hexadrop ESLint config: yml plugin, YAML language and conventions for .yml and .yaml files.",
	"keywords": [
		"lint",
		"eslint",
		"eslint-config",
		"yaml",
		"yml"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hexadrop/eslint-config.git",
		"directory": "packages/eslint-config-yaml"
	},
	"homepage": "https://github.com/hexadrop/eslint-config",
	"bugs": {
		"url": "https://github.com/hexadrop/eslint-config/issues"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "bun run build:types && tsdown",
		"build:types": "bun run scripts/typegen.ts",
		"prepare": "bun run build:types",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"eslint": "^9.38.0 || ^10.0.0"
	},
	"dependencies": {
		"eslint-flat-config-utils": "3.2.0",
		"eslint-plugin-yml": "3.10.0"
	},
	"devDependencies": {
		"tsdown": "0.23.4"
	}
}
