{
	"name": "@hexadrop/eslint-config-astro",
	"version": "1.0.11",
	"description": "Astro slice of the hexadrop ESLint config: eslint-plugin-astro, astro-eslint-parser and prettier-plugin-astro rules.",
	"keywords": [
		"lint",
		"eslint",
		"eslint-config",
		"astro"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hexadrop/eslint-config.git",
		"directory": "packages/eslint-config-astro"
	},
	"homepage": "https://github.com/hexadrop/eslint-config",
	"bugs": {
		"url": "https://github.com/hexadrop/eslint-config/issues"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "bun run build:types && tsdown",
		"build:types": "bun run scripts/typegen.ts",
		"prepare": "bun run build:types",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"eslint": "^9.17.0 || ^10.0.0"
	},
	"peerDependenciesMeta": {
		"@hexadrop/eslint-config-typescript": {
			"optional": true
		}
	},
	"dependencies": {
		"@typescript-eslint/parser": "8.68.0",
		"astro-eslint-parser": "3.1.0",
		"eslint-flat-config-utils": "3.2.0",
		"eslint-plugin-astro": "3.1.0",
		"globals": "17.11.0",
		"local-pkg": "1.2.1"
	},
	"devDependencies": {
		"tsdown": "0.22.14"
	}
}
