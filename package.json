{
	"name": "eslint-config",
	"description": "Opinionated linting configuration using best practices and providing consistency to your code.",
	"keywords": [
		"lint",
		"eslint",
		"eslint-config",
		"monorepo",
		"scalable",
		"scale",
		"typescript",
		"prettier"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hexadrop/eslint-config.git"
	},
	"homepage": "https://github.com/hexadrop/eslint-config",
	"bugs": {
		"url": "https://github.com/hexadrop/eslint-config/issues"
	},
	"license": "MIT",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "bun run --filter '*' build",
		"check:dist": "bun run build && bun scripts/check-distribution-dependencies.ts",
		"commitlint": "commitlint --edit",
		"lint": "NODE_OPTIONS='--conditions=development' eslint --cache .",
		"lint:ci": "NODE_OPTIONS='--conditions=development' eslint --cache --cache-strategy content .",
		"lint:fix": "NODE_OPTIONS='--conditions=development' eslint --cache --fix .",
		"prepare": "husky && bun run --filter '*' prepare",
		"test": "bun test packages",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@eslint/config-inspector": "3.5.0",
		"@hexadrop/tsconfig": "0.0.5",
		"@types/bun": "1.4.4",
		"eslint": "10.13.0",
		"husky": "9.1.7",
		"jiti": "2.7.0",
		"lint-staged": "17.6.0",
		"tsdown": "0.23.1",
		"typescript": "6.0.3"
	}
}
