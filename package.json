{
	"name": "eslint-config",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run --filter @hexadrop/eslint-config build",
		"commitlint": "commitlint --edit",
		"lint": "eslint --cache .",
		"lint:ci": "eslint --cache --cache-strategy content .",
		"lint:fix": "eslint --cache --fix .",
		"prepare": "husky",
		"test": "bun test packages"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.1",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@eslint/config-inspector": "3.3.0",
		"@hexadrop/tsconfig": "0.0.5",
		"@types/bun": "1.4.0",
		"eslint": "10.9.1",
		"husky": "9.1.7",
		"jiti": "2.7.0",
		"lint-staged": "17.3.0",
		"tsdown": "0.22.14",
		"typescript": "6.0.3"
	}
}
