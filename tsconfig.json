{
	"extends": "@hexadrop/tsconfig",
	"compilerOptions": {
		"paths": {
			"@hexadrop/eslint-config-json": ["./packages/eslint-config-json/src/index.ts"],
			"@hexadrop/eslint-config-json/*": ["./packages/eslint-config-json/src/*"],
			"@hexadrop/eslint-config-markdown": ["./packages/eslint-config-markdown/src/index.ts"],
			"@hexadrop/eslint-config-markdown/*": ["./packages/eslint-config-markdown/src/*"],
			"@hexadrop/eslint-config-shared": ["./packages/eslint-config-shared/src/index.ts"],
			"@hexadrop/eslint-config-shared/*": ["./packages/eslint-config-shared/src/*"]
		},
		"types": ["bun"]
	},
	"exclude": ["dist", "node_modules", "packages/*/e2e/fixtures"]
}
